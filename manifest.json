{
  "manifest_version": 3,
  "name": "CroVim",
  "version": "0.1.0",
  "description": "Vim-style keyboard navigation for Chrome, Firefox, Brave, and other modern browsers.",
  "permissions": [
    "storage",
    "tabs",
    "bookmarks",
    "history",
    "sessions",
    "search",
    "scripting",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "crovim@seanizonfire.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "scripts": [
      "service-worker.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "CroVim",
    "default_popup": "pages/popup.html"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pages/vomnibar.html",
        "pages/help-dialog.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "commands": {
    "create-tab": {
      "description": "Create a new tab"
    },
    "next-tab": {
      "description": "Activate the next tab"
    },
    "previous-tab": {
      "description": "Activate the previous tab"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
